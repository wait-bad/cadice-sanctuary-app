<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 顶部高端品牌区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟣"
                android:textSize="44sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Violet IM"
                android:textColor="#F8FAFC"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="通用轻量级私有云即时通信客户端"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 卡片 1: 服务器端点设置 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐 服务器地址"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="输入您的 VoceChat 服务节点（支持局域网 HTTP 或公网 HTTPS）"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/et_server_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#0F172A"
                    android:textColor="#F8FAFC"
                    android:textColorHint="#64748B"
                    android:hint="https://chat.waitb.sbs 或 http://192.168.1.20:3009"
                    android:textSize="13sp"
                    android:padding="12dp"
                    android:singleLine="true" />

                <!-- 预设快速切换 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btn_quick_remote"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="公网隧道"
                        android:textSize="11sp"
                        android:padding="0dp"
                        android:textColor="#A855F7"
                        app:strokeColor="#7E22CE"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_quick_local"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="局域网内网"
                        android:textSize="11sp"
                        android:padding="0dp"
                        android:textColor="#38BDF8"
                        app:strokeColor="#0284C7"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_ping_server"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#334155"
                    android:text="⚡ 探测连通性"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_ping_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#10B981"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 卡片 2: 登录认证 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔑 账号凭证登录"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="输入您注册的账号邮箱与密码，登录态将安全固化"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/et_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#0F172A"
                    android:textColor="#F8FAFC"
                    android:textColorHint="#64748B"
                    android:hint="注册账号 / 邮箱"
                    android:textSize="13sp"
                    android:padding="12dp"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#0F172A"
                    android:textColor="#F8FAFC"
                    android:textColorHint="#64748B"
                    android:hint="登录密码"
                    android:inputType="textPassword"
                    android:textSize="13sp"
                    android:padding="12dp"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#7C3AED"
                    android:text="登录系统"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 底部版权 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#475569"
            android:textSize="11sp"
            android:text="Violet IM · Universal Open Source Client\nBuild v1.2.0" />

    </LinearLayout>
</ScrollView>
