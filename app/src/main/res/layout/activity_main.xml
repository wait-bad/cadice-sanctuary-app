<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- 主滚动内容 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="56dp"
            android:paddingBottom="72dp">

            <!-- 🌸 可黛丝旋转小花 Logo -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_rotating_flower"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌸"
                    android:textSize="64sp"
                    android:gravity="center" />
            </FrameLayout>

            <!-- 产品标题与极简副标 -->
            <TextView
                android:id="@+id/tv_brand_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Violet IM"
                android:textColor="#F8FAFC"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tv_brand_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="私有云全双工通信平台"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:letterSpacing="0.03"
                android:layout_marginTop="4dp" />

            <!-- 当前选定服务器胶囊展示（点击弹出配置窗口） -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_open_server_modal"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="28dp"
                app:cardBackgroundColor="#1E293B"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:id="@+id/tv_current_server_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌐"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_current_server_display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="chat.waitb.sbs"
                        android:textColor="#38BDF8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginStart="6dp"
                        android:singleLine="true"
                        android:maxWidth="200dp" />

                    <TextView
                        android:id="@+id/tv_server_edit_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" ⚙️"
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 仿 QQ 极简现代输入窗 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 账号输入胶囊条 -->
                <LinearLayout
                    android:id="@+id/layout_input_account"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="#1E293B"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/icon_account"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👤"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/et_email"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:textColor="#F8FAFC"
                        android:textColorHint="#64748B"
                        android:hint="邮箱 / 用户名"
                        android:textSize="14sp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- 密码输入胶囊条 -->
                <LinearLayout
                    android:id="@+id/layout_input_password"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="#1E293B"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/icon_password"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/et_password"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:textColor="#F8FAFC"
                        android:textColorHint="#64748B"
                        android:hint="登录密码"
                        android:inputType="textPassword"
                        android:textSize="14sp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/btn_toggle_pwd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👁️"
                        android:textSize="14sp"
                        android:padding="6dp" />
                </LinearLayout>

                <!-- 登录主按键（仿 QQ 高级圆角胶囊按键） -->
                <Button
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="28dp"
                    android:backgroundTint="#7C3AED"
                    android:text="登 录"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    app:cornerRadius="26dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 底部常驻栏：左下角明暗主题切换标志 -->
    <LinearLayout
        android:id="@+id/btn_toggle_theme"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="?android:attr/selectableItemBackground">

        <TextView
            android:id="@+id/tv_theme_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌙"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_theme_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="暗色模式"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</RelativeLayout>
