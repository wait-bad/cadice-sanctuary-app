<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialog_server_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E293B"
    android:padding="20dp">

    <!-- 弹窗标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🌐 服务器连接配置"
            android:textColor="#F8FAFC"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_dialog_close"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="关闭"
            android:textColor="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_dialog_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="选择已有服务器或输入新的 VoceChat 节点地址："
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:layout_marginBottom="12dp" />

    <!-- 添加新服务器输入框与按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/et_new_server"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#0F172A"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:hint="https:// 或 http://"
            android:textSize="13sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true" />

        <Button
            android:id="@+id/btn_add_server"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:backgroundTint="#7C3AED"
            android:text="添加"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_history_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="常用与历史服务器列表："
        android:textColor="#64748B"
        android:textSize="11sp"
        android:layout_marginBottom="8dp" />

    <!-- 动态历史服务器列表容器 -->
    <LinearLayout
        android:id="@+id/layout_server_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
