<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 主页面内容 -->
    <LinearLayout
        android:id="@+id/home_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0F172A">

        <!-- 顶部高端 AppBar（点击左上角头像可呼出 QQ 风格侧边栏） -->
        <LinearLayout
            android:id="@+id/home_topbar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#1E293B"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:elevation="4dp">

            <!-- 自己圆形小头像（点击展开侧边栏） -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_my_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="#7C3AED"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/tv_my_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/iv_my_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="我的头像" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/btn_open_drawer_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_home_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Violet IM"
                    android:textColor="#F8FAFC"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_home_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 已连接 · 在线"
                    android:textColor="#10B981"
                    android:textSize="11sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

        </LinearLayout>

        <!-- 中间内容容器 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 页面 1: 会话列表（带 QQ 风格圆角搜索框 + 花瓣下拉刷新） -->
            <com.sanctuary.cadice.FlowerPullRefreshLayout
                android:id="@+id/refresh_chats"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/layout_tab_chats"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- QQ 风格顶部圆角搜索框 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_qq_search_bar"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        app:cardBackgroundColor="#1E293B"
                        app:cardCornerRadius="19dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#334155"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <ImageView
                                android:id="@+id/iv_qq_search_icon"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_search"
                                android:contentDescription="搜索图标" />

                            <TextView
                                android:id="@+id/tv_qq_search_hint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="搜索聊天记录"
                                android:textColor="#94A3B8"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <ProgressBar
                        android:id="@+id/pb_loading"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="24dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_empty_chats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:layout_marginTop="36dp"
                        android:text="暂无正在进行的会话\n可在「联系人」中点击群组或好友开启聊天"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_conversations"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:paddingTop="2dp"
                        android:paddingBottom="8dp" />
                </LinearLayout>
            </com.sanctuary.cadice.FlowerPullRefreshLayout>

            <!-- 页面 2: 联系人列表（花瓣下拉刷新） -->
            <com.sanctuary.cadice.FlowerPullRefreshLayout
                android:id="@+id/refresh_contacts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/layout_tab_contacts"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_contacts_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="群聊与好友名录"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="6dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_contacts"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </com.sanctuary.cadice.FlowerPullRefreshLayout>

            <!-- 页面 3: 空间 Tab（花瓣下拉刷新） -->
            <com.sanctuary.cadice.FlowerPullRefreshLayout
                android:id="@+id/refresh_moments"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <ScrollView
                    android:id="@+id/layout_tab_moments"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            app:cardBackgroundColor="#334155"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🌸 私有动态空间"
                                    android:textColor="#F8FAFC"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="纯血私有微中枢 (Port 3012) 准备就绪"
                                    android:textColor="#94A3B8"
                                    android:textSize="12sp"
                                    android:layout_marginTop="6dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="✨ 正在打通服务器端 3012 微中枢，届时支持九宫格原图、点赞与楼中楼树状评论！"
                            android:textColor="#64748B"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:layout_marginTop="32dp" />
                    </LinearLayout>
                </ScrollView>
            </com.sanctuary.cadice.FlowerPullRefreshLayout>
        </FrameLayout>

        <!-- 底部三大金刚导航栏 -->
        <LinearLayout
            android:id="@+id/home_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="#1E293B"
            android:orientation="horizontal"
            android:elevation="8dp">

            <LinearLayout
                android:id="@+id/nav_chats"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tv_nav_chats_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💬"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tv_nav_chats_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="消息"
                    android:textColor="#7C3AED"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_contacts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tv_nav_contacts_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👥"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tv_nav_contacts_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="联系人"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_moments"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tv_nav_moments_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌸"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tv_nav_moments_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="空间"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 🌸 仿 QQ 左侧滑抽屉侧边栏 -->
    <LinearLayout
        android:id="@+id/drawer_container"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#1E293B"
        android:clickable="true"
        android:focusable="true">

        <!-- 顶部个人名片背景区 -->
        <LinearLayout
            android:id="@+id/drawer_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="44dp"
            android:paddingBottom="22dp"
            android:background="#0F172A">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_drawer_avatar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:cardBackgroundColor="#7C3AED"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp"
                app:strokeColor="#7C3AED"
                app:strokeWidth="2dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/tv_drawer_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/iv_drawer_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="侧边栏头像" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_drawer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="小窝成员"
                android:textColor="#F8FAFC"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_drawer_server"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="chat.waitb.sbs"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- 菜单项区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="18dp">

            <!-- 全局日/夜间模式切换 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_drawer_theme"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="#0F172A"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/tv_drawer_theme_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌙"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tv_drawer_theme_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="夜间模式"
                        android:textColor="#F8FAFC"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_drawer_theme_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="切换日间"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 全屏设置入口 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_drawer_settings"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="#0F172A"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙️"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tv_drawer_settings_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="设置"
                        android:textColor="#F8FAFC"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_drawer_settings_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="头像 / 字体"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- 底部退出登录 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_home_logout"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="退出当前账号"
                android:textColor="#EF4444"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:strokeColor="#EF4444"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
